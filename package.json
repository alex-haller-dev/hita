{
  "name": "hita",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@hita/web",
    "dev:studio": "npm run dev --workspace=@hita/studio",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=@hita/web",
    "build:studio": "npm run build --workspace=@hita/studio",
    "deploy:studio": "npm run deploy --workspace=@hita/studio"
  },
  "allowScripts": {
    "esbuild": true
  }
}
