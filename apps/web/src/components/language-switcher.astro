---
export type LanguagePathOverrides = Partial<Record<'de' | 'en', string>>

interface Props {
    // Overrides the default /en prefix logic, for pages whose URL differs per language
    languagePathOverrides?: LanguagePathOverrides
}

const { languagePathOverrides } = Astro.props
const currentPath = Astro.url.pathname
const current = currentPath.startsWith('/en') ? 'en' : 'de'

const getHref = (targetLang: 'de' | 'en') => {
    if (languagePathOverrides?.[targetLang]) return languagePathOverrides?.[targetLang]
    if (targetLang === 'en') {
        if (current === 'en') return currentPath
        // Add /en prefix; trailing slash on root handled automatically
        return `/en${currentPath}`
    } else {
        if (current === 'de') return currentPath
        // Remove /en prefix
        const stripped = currentPath.replace(/^\/en/, '')
        return stripped || '/'
    }
}

const languages = [
    { code: 'de', label: 'DE', name: 'Deutsch', href: getHref('de') },
    { code: 'en', label: 'EN', name: 'English', href: getHref('en') },
];
---

<div
    role="group"
    aria-label="Sprache wählen / Select language"
    class="inline-flex items-center rounded-full border border-gray-200 bg-gray-50 p-0.5 text-xs font-semibold tracking-wide"
>
    {languages.map((lang) => {
        const active = lang.code === current
        return (
            <a
                href={lang.href}
                hreflang={lang.code}
                lang={lang.code}
                title={lang.name}
                aria-current={active ? 'true' : undefined}
                class:list={[
                    'rounded-full px-2.5 py-1 transition-colors sm:px-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand',
                    active
                        ? 'bg-brand text-white shadow-sm'
                        : 'text-gray-600 hover:text-brand',
                ]}
            >
                {lang.label}
            </a>
        )
    })}
</div>
