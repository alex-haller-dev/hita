---
import { translate } from '../translations/translations'
import Card from './card.astro'
import Icon from './icon.astro'

const locale = Astro.currentLocale ?? 'de'
const t = (key: Parameters<typeof translate>[0]) => translate(key, locale)

const iban = 'DE86 6907 0024 0050 6006 00'
// On narrow cards the IBAN wraps between its two halves instead of leaving the last digits on their own line
const ibanGroups = iban.split(' ')
const ibanLines = [ibanGroups.slice(0, 3).join(' '), ibanGroups.slice(3).join(' ')]
const bic = 'DEUTDEDB690';
---

<div class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="grid gap-8 lg:grid-cols-3">

            <!-- Monetary Donation -->
            <Card title={t('supportDonateHeading')} icon="heart" headingLevel={2} variant="large">
                <p class="mt-3 leading-relaxed text-gray-600">{t('supportDonateText')}</p>

                <ul class="mt-4 space-y-2">
                    <li class="flex gap-2 text-sm text-gray-600">
                        <Icon name="checkCircle" class="mt-0.5 size-4 shrink-0 text-brand" />
                        {t('supportDonateExample1')}
                    </li>
                    <li class="flex gap-2 text-sm text-gray-600">
                        <Icon name="checkCircle" class="mt-0.5 size-4 shrink-0 text-brand" />
                        {t('supportDonateExample2')}
                    </li>
                </ul>

                <div class="mt-6 rounded-xl bg-gray-50 p-4 text-sm">
                    <p class="mb-3 font-semibold text-gray-700">{t('supportBankDetails')}</p>
                    <dl class="space-y-1.5 text-gray-600">
                        <div class="flex flex-wrap justify-between gap-x-4">
                            <dt>{t('footerAccountHolder')}</dt>
                            <dd class="font-medium text-gray-800">HITA e.V.</dd>
                        </div>
                        <div class="flex flex-wrap justify-between gap-x-4">
                            <dt>{t('footerBank')}</dt>
                            <dd class="font-medium text-gray-800">Deutsche Bank</dd>
                        </div>
                        <div class="flex flex-wrap justify-between gap-x-4">
                            <dt>IBAN</dt>
                            <dd class="ml-auto text-right font-mono font-medium text-gray-800">
                                <!-- TODO: on desktop view we have a line break from IBAN to the actual IBAN code, this should be in one line with no line breaks -->
                                <span class="whitespace-nowrap">{ibanLines[0]}</span>{' '}<span class="whitespace-nowrap">{ibanLines[1]}</span>
                            </dd>
                        </div>
                        <div class="flex flex-wrap justify-between gap-x-4">
                            <dt>BIC</dt>
                            <dd class="font-mono font-medium text-gray-800">{bic}</dd>
                        </div>
                    </dl>
                </div>

                <p class="mt-4 text-xs leading-relaxed text-gray-500">{t('supportDonateTax')}</p>

                <button
                    type="button"
                    class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                    onclick={`navigator.clipboard.writeText('${iban}').then(() => { this.textContent = '✓ IBAN'; setTimeout(() => this.textContent = '${t('supportDonateButton')}', 2000); })`}
                >
                    {t('supportDonateButton')}
                </button>
            </Card>

            <!-- Membership -->
            <Card id="membership" title={t('supportMembershipHeading')} icon="users" headingLevel={2} variant="large">
                <p class="mt-3 leading-relaxed text-gray-600">{t('supportMembershipText')}</p>

                <ul class="mt-6 space-y-3">
                    <li class="flex items-center justify-between rounded-xl bg-gray-50 px-4 py-3">
                        <span class="text-sm text-gray-700">{t('supportMembershipFull')}</span>
                        <span class="font-bold text-gray-900">{t('supportMembershipFullPrice')}</span>
                    </li>
                    <li class="flex items-center justify-between rounded-xl bg-gray-50 px-4 py-3">
                        <span class="text-sm text-gray-700">{t('supportMembershipReduced')}</span>
                        <span class="font-bold text-gray-900">{t('supportMembershipReducedPrice')}</span>
                    </li>
                    <li class="flex items-center justify-between rounded-xl bg-gray-50 px-4 py-3">
                        <span class="text-sm text-gray-700">{t('supportMembershipCorporate')}</span>
                        <span class="font-bold text-gray-900">{t('supportMembershipCorporatePrice')}</span>
                    </li>
                </ul>

                <p class="mt-4 text-sm leading-relaxed wrap-anywhere text-gray-500">{t('supportMembershipContact')}</p>

                <a
                    href="mailto:geschaeftsstelle@hita-ev.org"
                    class="mt-auto inline-flex items-center justify-center gap-2 rounded-full border border-gray-300 bg-white px-5 py-2.5 text-sm font-semibold text-gray-800 transition-colors hover:border-brand hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                >
                    {t('supportMembershipButton')}
                </a>
            </Card>

            <!-- Volunteer -->
            <Card title={t('supportVolunteerHeading')} icon="activity" headingLevel={2} variant="large">
                <p class="mt-3 leading-relaxed text-gray-600">{t('supportVolunteerText')}</p>
                <p class="mt-4 leading-relaxed text-gray-600">{t('supportVolunteerDetails')}</p>

                <a
                    href="mailto:info@hita-ev.org"
                    class="mt-auto inline-flex items-center justify-center gap-2 rounded-full border border-gray-300 bg-white px-5 py-2.5 text-sm font-semibold text-gray-800 transition-colors hover:border-brand hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                >
                    {t('supportVolunteerButton')}
                </a>
            </Card>

        </div>

        <!-- Crowdfunding -->
        <div class="mt-8 flex flex-col gap-6 rounded-2xl bg-brand/5 p-6 ring-1 ring-brand/10 sm:p-8 md:flex-row md:items-center">
            <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-brand/10">
                <Icon name="shoppingBag" class="size-6 text-brand" />
            </div>
            <div class="flex-1">
                <h2 class="text-xl font-bold text-gray-900">{t('supportCrowdfundingHeading')}</h2>
                <p class="mt-2 leading-relaxed text-gray-600">{t('supportCrowdfundingText')}</p>
            </div>
            <a
                href="https://www.wecanhelp.de/hita-ev"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            >
                {t('supportCrowdfundingButton')}
                <Icon name="arrowRight" class="size-4" />
            </a>
        </div>
    </div>
</div>
