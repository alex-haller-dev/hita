---
import { translate } from '../translations/translations'
import { resolvePath } from '../utils/path.ts'
import Icon from './icon.astro'
import type { IconName } from '../constants/icons.ts'

const locale = Astro.currentLocale ?? 'de'
const t = (key: Parameters<typeof translate>[0]) => translate(key, locale)

const socials: { name: string; href: string; icon: IconName }[] = [
    {
        name: 'Facebook',
        href: 'https://www.facebook.com/HITA-eV-Healthcare-Information-Technologies-for-Africa-eV-448468271870135/',
        icon: 'facebook',
    },
    {
        name: 'Instagram',
        href: 'https://www.instagram.com/hita_ev/',
        icon: 'instagram',
    },
    {
        name: 'LinkedIn',
        href: 'https://www.linkedin.com/in/hita-ev-b10a16145/',
        icon: 'linkedin',
    },
    {
        name: 'X (Twitter)',
        href: 'https://twitter.com/HITA_eV',
        icon: 'x',
    },
    {
        name: 'YouTube',
        href: 'https://www.youtube.com/@HITAeV',
        icon: 'youtube',
    },
]

const legalLinks = [
    { label: t('footerImprint'), href: resolvePath('/legal-notice', Astro.currentLocale) },
    { label: t('footerPrivacy'), href: resolvePath('/privacy-policy', Astro.currentLocale) },
]

const year = new Date().getFullYear()

const headingClass = 'mb-4 text-xs font-bold tracking-widest text-white uppercase'
const labelClass = 'text-xs text-gray-400'
const linkClass =
    'rounded-sm transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand';
---

<footer class="border-t-4 border-brand bg-gray-900 text-sm text-gray-300">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
        <div>
            <img
                src="/images/hita-logo-modern-white.svg"
                alt="HITA – Health Care IT for Africa e.V."
                width="196"
                height="108"
                class="h-20 w-auto"
            />
            <p class="mt-4 leading-relaxed text-gray-400">
                {t('footerTagline')}
            </p>
            <ul class="mt-6 flex flex-wrap gap-2" aria-label={t('footerSocialMedia')}>
                {socials.map((social) => (
                    <li>
                        <a
                            href={social.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={social.name}
                            title={social.name}
                            class="flex size-9 items-center justify-center rounded-full bg-white/10 text-gray-300 transition-colors hover:bg-brand hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                        >
                            <Icon name={social.icon} class="size-4" />
                        </a>
                    </li>
                ))}
            </ul>
        </div>

        <div>
            <h2 class={headingClass}>{t('footerOffice')}</h2>
            <address class="leading-relaxed not-italic">
                Healthcare IT for Africa e.V. <span class="whitespace-nowrap">(HITA e.V.)</span><br />
                c/o Marion Fellmann<br />
                Josef-Schmitt-Str. 4<br />
                D-97922 Lauda-Königshofen
            </address>
        </div>

        <div>
            <h2 class={headingClass}>{t('footerContact')}</h2>
            <dl class="space-y-3">
                <div>
                    <dt class={labelClass}>{t('footerPhone')}</dt>
                    <dd><a href="tel:+4915678952247" class={linkClass}>+49 15678 952247</a></dd>
                </div>
                <div>
                    <dt class={labelClass}>{t('footerEmail')}</dt>
                    <dd>
                        <a href="mailto:geschaeftsstelle@hita-ev.org" class={`${linkClass} break-all`}>
                            geschaeftsstelle@hita-ev.org
                        </a>
                    </dd>
                </div>
            </dl>
        </div>

        <div>
            <h2 class={headingClass}>{t('footerDonationAccount')}</h2>
            <dl class="space-y-3">
                <div>
                    <dt class={labelClass}>{t('footerAccountHolder')}</dt>
                    <dd>HITA e.V.</dd>
                </div>
                <div>
                    <dt class={labelClass}>{t('footerBank')}</dt>
                    <dd>Deutsche Bank</dd>
                </div>
                <div>
                    <dt class={labelClass}>IBAN</dt>
                    <dd class="font-mono whitespace-nowrap text-white">DE86 6907 0024 0050 6006 00</dd>
                </div>
                <div>
                    <dt class={labelClass}>BIC</dt>
                    <dd class="font-mono text-white">DEUTDEDB690</dd>
                </div>
            </dl>
        </div>
    </div>

    <div class="border-t border-white/10">
        <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-6 text-xs text-gray-400 sm:px-6 md:flex-row md:items-start md:justify-between">
            <div class="space-y-1 md:max-w-3xl">
                <p>© {year} Health Care IT for Africa e.V. (HITA e.V.) · {t('footerRightsReserved')}</p>
                <p class="leading-relaxed">{t('footerRegistration')}</p>
            </div>
            <nav aria-label={t('footerLegal')}>
                <ul class="flex gap-4">
                    {legalLinks.map((link) => (
                        <li>
                            <a href={link.href} class={`${linkClass} text-gray-300`}>{link.label}</a>
                        </li>
                    ))}
                </ul>
            </nav>
        </div>
    </div>
</footer>
