---
import {type FAQItem} from '../constants/FAQ.ts'
import Faq from './faq.astro'

interface Props {
    FAQItems: FAQItem[]
    heading?: string
}

const { FAQItems, heading = 'FAQ' } = Astro.props
---

<section class="border-t border-gray-100 bg-white">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
        <h2 class="mb-10 text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">{heading}</h2>
        <div class="divide-y divide-gray-100">
            { FAQItems.map(({ question, answer }) => <Faq question={question} answer={answer} />) }
        </div>
    </div>
</section>
