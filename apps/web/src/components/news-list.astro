---
import { translate } from '../translations/translations';
import { resolvePath } from '../utils/path';
import { formatNewsDate, getNewsSummaries } from '../utils/news';
import { urlFor } from '../utils/sanity';
import Icon from './icon.astro';

const locale = Astro.currentLocale === 'en' ? 'en' : 'de';
const t = (key: Parameters<typeof translate>[0]) => translate(key, locale);

const posts = await getNewsSummaries(locale);
---

<div class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        {posts.length === 0 ? (
            <div class="flex flex-col items-center py-8 text-center">
                <div class="mb-6 flex size-16 items-center justify-center rounded-full bg-gray-100">
                    <Icon name="newspaper" class="size-8 text-gray-400" />
                </div>
                <p class="max-w-sm text-gray-500">{t('newsEmpty')}</p>
            </div>
        ) : (
            <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {posts.map((post) => (
                    <li>
                        <a
                            href={resolvePath(`/news/${post.slug}`, locale)}
                            class="group flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-100 transition-shadow hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                        >
                            <div class="aspect-video bg-gray-100">
                                {post.featured_media && (
                                    <img
                                        src={urlFor(post.featured_media).width(640).height(360).url()}
                                        alt={post.featured_media.alt_text ?? ''}
                                        width="640"
                                        height="360"
                                        loading="lazy"
                                        class="size-full object-cover"
                                    />
                                )}
                            </div>
                            <div class="flex flex-1 flex-col p-6">
                                <time datetime={post.date} class="text-xs font-semibold tracking-wide text-gray-500 uppercase">
                                    {formatNewsDate(post.date, locale)}
                                </time>
                                <h2 class="mt-2 font-semibold text-gray-900 transition-colors group-hover:text-brand">{post.title}</h2>
                                {post.excerpt && <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-gray-600">{post.excerpt}</p>}
                                <span class="mt-auto inline-flex items-center gap-2 pt-5 text-sm font-semibold text-brand">
                                    {t('newsReadMore')}
                                    <Icon name="arrowRight" class="size-4" />
                                </span>
                            </div>
                        </a>
                    </li>
                ))}
            </ul>
        )}
    </div>
</div>
