---
import { getCollection } from 'astro:content'
import { translate } from '../translations/translations'
import { resolvePath } from '../utils/path'
import Icon from './icon.astro'

const locale = Astro.currentLocale ?? 'de'
const t = (key: Parameters<typeof translate>[0]) => translate(key, locale)

const reports = (await getCollection('annualReports', (entry) => entry.id.startsWith(`${locale}/`)))
    .sort((a, b) => b.data.year - a.data.year)

const linkClass =
    'inline-flex items-center justify-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand';
---

<div class="py-16 sm:py-20">
    <div class="mx-auto max-w-4xl space-y-6 px-4 sm:px-6">
        {reports.map((report) => (
            <article
                id={String(report.data.year)}
                class="scroll-mt-24 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-100 sm:grid sm:grid-cols-[7rem_1fr] sm:gap-8 sm:p-8"
            >
                <h2 class="text-3xl font-bold tracking-tight text-brand">{report.data.year}</h2>

                <div class="mt-4 sm:mt-1">
                    <p class="mb-3 text-xs font-bold tracking-widest text-gray-500 uppercase">{t('annualReportsHighlights')}</p>
                    <ul class="space-y-2">
                        {report.data.highlights.map((highlight) => (
                            <li class="flex gap-2 text-sm leading-relaxed text-gray-600">
                                <Icon name="checkCircle" class="mt-0.5 size-4 shrink-0 text-brand" />
                                <span class="min-w-0 break-words">{highlight}</span>
                            </li>
                        ))}
                    </ul>

                    {(report.body?.trim() || report.data.pdf) && (
                        <div class="mt-6 flex flex-wrap gap-3">
                            {report.body?.trim() && (
                                <a
                                    href={resolvePath(`/annual-reports/${report.data.year}`, locale)}
                                    class={`${linkClass} bg-brand text-white shadow-sm hover:bg-brand-dark`}
                                >
                                    {t('annualReportsReadMore')}
                                    <Icon name="arrowRight" class="size-4" />
                                </a>
                            )}
                            {report.data.pdf && (
                                <a
                                    href={report.data.pdf}
                                    target="_blank"
                                    rel="noopener"
                                    class={`${linkClass} border border-gray-300 bg-white text-gray-800 hover:border-brand hover:text-brand`}
                                >
                                    <Icon name="download" class="size-4" />
                                    {t('annualReportsDownload')}
                                </a>
                            )}
                        </div>
                    )}
                </div>
            </article>
        ))}
    </div>
</div>
