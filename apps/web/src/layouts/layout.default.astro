---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";
import type { Alternates } from "../components/language-switcher.astro";

interface Props {
    // Language switcher targets, for pages whose URL differs per language (e.g. news articles)
    alternates?: Alternates
}

const { alternates } = Astro.props
---

<html lang={Astro.currentLocale ?? "de"}>
    <head>
        <meta charset="utf-8" />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>HITA e.V. | Health Care Information Technologies for Africa e.V.</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    </head>
    <body class="flex min-h-screen flex-col bg-white font-sans text-gray-800 antialiased">
        <Header alternates={alternates} />
        <main class="flex-1">
            <slot name="hero" />
            <slot></slot>
        </main>
        <Footer />
    </body>
</html>
