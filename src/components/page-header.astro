---
interface Props {
    title: string
    subtitle?: string
}

const { title, subtitle } = Astro.props
---

<div class="border-b border-gray-100 bg-linear-to-b from-gray-50 to-white">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl">{title}</h1>
        {subtitle && (
            <p class="mt-4 max-w-2xl text-lg leading-relaxed text-gray-600">{subtitle}</p>
        )}
    </div>
</div>
