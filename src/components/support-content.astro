---
import { translate } from '../translations/translations';

const locale = Astro.currentLocale ?? 'de';
const t = (key: Parameters<typeof translate>[0]) => translate(key, locale);

const iban = 'DE86 6907 0024 0050 6006 00';
const bic = 'DEUTDEDB690';
---

<!-- TODO: we have lots of svg drawn icons all over the app, we should turn them into re-usable components -->
<div class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="grid gap-8 lg:grid-cols-3">

            <!-- Monetary Donation -->
            <div class="flex flex-col rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-100">
                <div class="mb-5 flex size-12 items-center justify-center rounded-xl bg-brand/10">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6 text-brand" aria-hidden="true">
                        <path d="M12 21s-7.5-4.6-9.6-9.3C.9 8.3 3 4.5 6.7 4.5c2.1 0 3.6 1.2 4.3 2.4h2c.7-1.2 2.2-2.4 4.3-2.4 3.7 0 5.8 3.8 4.3 7.2C19.5 16.4 12 21 12 21z" />
                    </svg>
                </div>

                <h2 class="text-xl font-bold text-gray-900">{t('supportDonateHeading')}</h2>
                <p class="mt-3 leading-relaxed text-gray-600">{t('supportDonateText')}</p>

                <ul class="mt-4 space-y-2">
                    <li class="flex gap-2 text-sm text-gray-600">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 size-4 shrink-0 text-brand" aria-hidden="true">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                        </svg>
                        {t('supportDonateExample1')}
                    </li>
                    <li class="flex gap-2 text-sm text-gray-600">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 size-4 shrink-0 text-brand" aria-hidden="true">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                        </svg>
                        {t('supportDonateExample2')}
                    </li>
                </ul>

                <div class="mt-6 rounded-xl bg-gray-50 p-4 text-sm">
                    <p class="mb-3 font-semibold text-gray-700">{t('supportBankDetails')}</p>
                    <dl class="space-y-1.5 text-gray-600">
                        <div class="flex justify-between gap-4">
                            <dt>{t('footerAccountHolder')}</dt>
                            <dd class="font-medium text-gray-800">HITA e.V.</dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt>{t('footerBank')}</dt>
                            <dd class="font-medium text-gray-800">Deutsche Bank</dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt>IBAN</dt>
                            <!-- TODO the IBAN isn't just one line, we have a line break for the last 2 digits -->
                            <dd class="font-mono font-medium text-gray-800">{iban}</dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt>BIC</dt>
                            <dd class="font-mono font-medium text-gray-800">{bic}</dd>
                        </div>
                    </dl>
                </div>

                <p class="mt-4 text-xs leading-relaxed text-gray-500">{t('supportDonateTax')}</p>

                <button
                    type="button"
                    class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                    onclick={`navigator.clipboard.writeText('${iban}').then(() => { this.textContent = '✓ IBAN'; setTimeout(() => this.textContent = '${t('supportDonateButton')}', 2000); })`}
                >
                    {t('supportDonateButton')}
                </button>
            </div>

            <!-- Membership -->
            <div id="membership" class="flex flex-col rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-100">
                <div class="mb-5 flex size-12 items-center justify-center rounded-xl bg-brand/10">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6 text-brand" aria-hidden="true">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>

                <h2 class="text-xl font-bold text-gray-900">{t('supportMembershipHeading')}</h2>
                <p class="mt-3 leading-relaxed text-gray-600">{t('supportMembershipText')}</p>

                <ul class="mt-6 space-y-3">
                    <li class="flex items-center justify-between rounded-xl bg-gray-50 px-4 py-3">
                        <span class="text-sm text-gray-700">{t('supportMembershipFull')}</span>
                        <span class="font-bold text-gray-900">60 €/Jahr</span>
                    </li>
                    <li class="flex items-center justify-between rounded-xl bg-gray-50 px-4 py-3">
                        <span class="text-sm text-gray-700">{t('supportMembershipReduced')}</span>
                        <span class="font-bold text-gray-900">30 €/Jahr</span>
                    </li>
                    <li class="flex items-center justify-between rounded-xl bg-gray-50 px-4 py-3">
                        <span class="text-sm text-gray-700">{t('supportMembershipCorporate')}</span>
                        <span class="font-bold text-gray-900">250 €/Jahr</span>
                    </li>
                </ul>

                <p class="mt-4 text-sm leading-relaxed text-gray-500">{t('supportMembershipContact')}</p>

                <a
                    href="mailto:geschaeftsstelle@hita-ev.org"
                    class="mt-auto inline-flex items-center justify-center gap-2 rounded-full border border-gray-300 bg-white px-5 py-2.5 text-sm font-semibold text-gray-800 transition-colors hover:border-brand hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                >
                    {t('supportMembershipButton')}
                </a>
            </div>

            <!-- Volunteer -->
            <div class="flex flex-col rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-100">
                <div class="mb-5 flex size-12 items-center justify-center rounded-xl bg-brand/10">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6 text-brand" aria-hidden="true">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                    </svg>
                </div>

                <h2 class="text-xl font-bold text-gray-900">{t('supportVolunteerHeading')}</h2>
                <p class="mt-3 leading-relaxed text-gray-600">{t('supportVolunteerText')}</p>
                <p class="mt-4 leading-relaxed text-gray-600">{t('supportVolunteerDetails')}</p>

                <a
                    href="mailto:info@hita-ev.org"
                    class="mt-auto inline-flex items-center justify-center gap-2 rounded-full border border-gray-300 bg-white px-5 py-2.5 text-sm font-semibold text-gray-800 transition-colors hover:border-brand hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                >
                    {t('supportVolunteerButton')}
                </a>
            </div>

        </div>
    </div>
</div>
