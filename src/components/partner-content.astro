---
import { translate } from '../translations/translations';

const locale = Astro.currentLocale ?? 'de';
const t = (key: Parameters<typeof translate>[0]) => translate(key, locale);

const partnerGroups = [
    {
        heading: t('partnerHospitals'),
        icon: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/><line x1="12" y1="5" x2="12" y2="5"/><line x1="9" y1="9" x2="15" y2="9"/>',
        partners: [
            'Lekma Hospital – Teshie',
            'EPC Adakklu Waya Clinic',
            'Hasu Policlinic',
        ],
    },
    {
        heading: t('partnerNGOs'),
        icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
        partners: [
            'Grow your own Dreams Foundation',
            'Chances Foundation',
            'ARTS Solutions',
            'Solid Rock Association',
            'Help Ghana Research Center',
        ],
    },
    {
        heading: t('partnerMedical'),
        icon: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
        partners: [
            'School of Nursing and Midwifery (SONAM)',
            'Sefwi Wiawso Berufsfachschule für Krankenpflege',
            'Nursing and Health Assistant Training School Teshie',
            'Midwifery and Health Assistant Training School – Tepa',
        ],
    },
    {
        heading: t('partnerSpecialEd'),
        icon: '<circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>',
        partners: [
            'Gbi Special School',
            'Volta School of the Deaf',
        ],
    },
    {
        heading: t('partnerSecondary'),
        icon: '<path d="M12 14l9-5-9-5-9 5 9 5z"/><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>',
        partners: [
            'Adaklu Senior High School',
            'Mawuli Senior High School',
            'Ola Girl\'s Senior High School',
            'Mawuko Girl\'s Senior High School',
            'CMS Senior High School',
        ],
    },
    {
        heading: t('partnerPrivate'),
        icon: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
        partners: [
            'Christ the King of King Schools',
            'Computer Training School Akosombo',
            'Jamestown Noyaa School',
            'HASU Elementary School',
            'Springs',
        ],
    },
    {
        heading: t('partnerOther'),
        icon: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
        partners: [locale === 'de' ? 'Start-ups' : 'Start-ups', locale === 'de' ? 'Waisenhäuser' : 'Orphanages'],
    },
];
---

<div class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {partnerGroups.map((group) => (
                <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-100">
                    <div class="mb-4 flex items-center gap-3">
                        <div class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-brand/10">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="size-4 text-brand"
                                aria-hidden="true"
                                set:html={group.icon}
                            />
                        </div>
                        <h2 class="font-semibold text-gray-900">{group.heading}</h2>
                    </div>
                    <ul class="space-y-1.5">
                        {group.partners.map((partner) => (
                            <li class="flex items-start gap-2 text-sm text-gray-600">
                                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-brand/50" aria-hidden="true"></span>
                                {partner}
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>
</div>
