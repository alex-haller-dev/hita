---
import LanguageSwitcher from "./language-switcher.astro";
import {translate} from "../translations/translations.ts";

const navItems = [
    { label: translate('projects', Astro.currentLocale), href: "#" },
    { label: translate('support', Astro.currentLocale), href: "#" },
];
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/90 backdrop-blur">
    <div class="mx-auto flex h-20 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="flex shrink-0 items-center" aria-label="HITA e.V. – Startseite">
            <img
                src="/images/hita-logo-modern.svg"
                alt="HITA – Health Care IT for Africa e.V."
                width="196"
                height="108"
                class="h-10 w-auto sm:h-14"
            />
        </a>

        <div class="flex items-center gap-1 sm:gap-6">
            <nav aria-label="Hauptnavigation">
                <ul class="flex items-center sm:gap-2">
                    {navItems.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                class="relative block rounded-md px-2 py-2 text-xs whitespace-nowrap font-semibold tracking-wide text-gray-700 uppercase transition-colors after:absolute after:inset-x-2 sm:after:inset-x-3 after:bottom-1 after:h-0.5 after:origin-left after:scale-x-0 after:bg-brand after:transition-transform hover:text-brand hover:after:scale-x-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:px-3 sm:text-base"
                            >
                                {item.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>

            <LanguageSwitcher />
        </div>
    </div>
</header>
