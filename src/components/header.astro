---
import LanguageSwitcher from "./language-switcher.astro";
import Icon from "./icon.astro";
import {translate} from "../translations/translations.ts";
import {resolvePath} from "../utils/path.ts";

const navItems = [
    { label: translate('aboutUs', Astro.currentLocale), href: resolvePath('/about-us', Astro.currentLocale) },
    { label: translate('support', Astro.currentLocale), href: resolvePath('/support', Astro.currentLocale) },
    { label: translate('projects', Astro.currentLocale), href: resolvePath('/projects', Astro.currentLocale) },
    { label: translate('news', Astro.currentLocale), href: resolvePath('/news', Astro.currentLocale) },
    { label: translate('partner', Astro.currentLocale), href: resolvePath('/partner', Astro.currentLocale) },
    { label: translate('annualReports', Astro.currentLocale), href: resolvePath('/annual-reports', Astro.currentLocale) },
];

const navLabel = translate('mainNavigation', Astro.currentLocale)
---

<header data-header class="group/header sticky top-0 z-50 border-b border-gray-200 bg-white/90 backdrop-blur">
    <div class="mx-auto flex h-20 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href={resolvePath("/", Astro.currentLocale)} class="flex shrink-0 items-center" aria-label="HITA e.V. – Startseite">
            <img
                src="/images/hita-logo-modern.svg"
                alt="HITA – Health Care IT for Africa e.V."
                width="196"
                height="108"
                class="h-10 w-auto sm:h-14"
            />
        </a>

        <div class="flex items-center gap-2 lg:gap-6">
            <!-- The full navigation only fits from lg upwards, smaller screens use the menu below -->
            <nav aria-label={navLabel} class="hidden lg:block">
                <ul class="flex items-center gap-2">
                    {navItems.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                class="relative block rounded-md px-3 py-2 text-base whitespace-nowrap font-semibold tracking-wide text-gray-700 uppercase transition-colors after:absolute after:inset-x-3 after:bottom-1 after:h-0.5 after:origin-left after:scale-x-0 after:bg-brand after:transition-transform hover:text-brand hover:after:scale-x-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                            >
                                {item.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>

            <LanguageSwitcher />

            <button
                type="button"
                data-menu-toggle
                aria-expanded="false"
                aria-controls="mobile-menu"
                aria-label={translate('menuToggle', Astro.currentLocale)}
                class="flex size-10 cursor-pointer items-center justify-center rounded-full text-gray-700 transition-colors hover:bg-gray-100 hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand lg:hidden"
            >
                <Icon name="menu" class="size-6 group-data-open/header:hidden" />
                <Icon name="close" class="hidden size-6 group-data-open/header:block" />
            </button>
        </div>
    </div>

    <div class="lg:hidden">
        <nav id="mobile-menu" aria-label={navLabel} class="hidden border-t border-gray-200 bg-white group-data-open/header:block">
            <ul class="mx-auto max-w-6xl space-y-1 px-4 py-4 sm:px-6">
                {navItems.map((item) => (
                    <li>
                        <a
                            href={item.href}
                            class="block rounded-lg px-3 py-3 text-base font-semibold tracking-wide text-gray-700 uppercase transition-colors hover:bg-gray-50 hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                        >
                            {item.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>

<script>
    const header = document.querySelector<HTMLElement>("[data-header]")
    const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]")

    if (header && toggle) {
        const setOpen = (open: boolean) => {
            header.toggleAttribute("data-open", open)
            toggle.setAttribute("aria-expanded", String(open))
        }

        toggle.addEventListener("click", () => setOpen(!header.hasAttribute("data-open")))

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && header.hasAttribute("data-open")) {
                setOpen(false)
                toggle.focus()
            }
        })
    }
</script>
