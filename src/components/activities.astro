---
import { translate } from '../translations/translations';

const locale = Astro.currentLocale ?? 'de';
const t = (key: Parameters<typeof translate>[0]) => translate(key, locale);

const activities = [
    {
        title: t('activity1'),
        text: t('activity1Text'),
        icon: '<path d="M12 14l9-5-9-5-9 5 9 5z"/><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>',
    },
    {
        title: t('activity2'),
        text: t('activity2Text'),
        icon: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
    },
    {
        title: t('activity3'),
        text: t('activity3Text'),
        icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    },
    {
        title: t('activity4'),
        text: t('activity4Text'),
        icon: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
    },
    {
        title: t('activity5'),
        text: t('activity5Text'),
        icon: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
    },
    {
        title: t('activity6'),
        text: t('activity6Text'),
        icon: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
    },
];
---

<section class="bg-gray-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mb-12 text-center">
            <h2 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">{t('homeMissionHeading')}</h2>
            <p class="mt-4 text-lg text-gray-600">{t('homeMissionSubtitle')}</p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <!-- TODO: we use these cards in several places on the app, we should make it a shared component -->
            {activities.map((activity) => (
                <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-100">
                    <div class="mb-4 flex size-10 items-center justify-center rounded-xl bg-brand/10">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="size-5 text-brand"
                            aria-hidden="true"
                            set:html={activity.icon}
                        />
                    </div>
                    <h3 class="mb-2 font-semibold text-gray-900">{activity.title}</h3>
                    <p class="text-sm leading-relaxed text-gray-600">{activity.text}</p>
                </div>
            ))}
        </div>
    </div>
</section>
