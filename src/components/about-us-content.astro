---
import { translate } from '../translations/translations';

const locale = Astro.currentLocale ?? 'de';
const t = (key: Parameters<typeof translate>[0]) => translate(key, locale);

const stats = [
    { value: '40+', label: t('heroStatLabs') },
    { value: '500+', label: t('heroStatComputers') },
    { value: '100%', label: t('heroStatVolunteers') },
];

const activities = [
    {
        title: t('homeActivity1'),
        text: t('homeActivity1Text'),
        icon: '<path d="M12 14l9-5-9-5-9 5 9 5z"/><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>',
    },
    {
        title: t('homeActivity2'),
        text: t('homeActivity2Text'),
        icon: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
    },
    {
        title: t('homeActivity3'),
        text: t('homeActivity3Text'),
        icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    },
    {
        title: t('homeActivity4'),
        text: t('homeActivity4Text'),
        icon: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
    },
    {
        title: t('homeActivity5'),
        text: t('homeActivity5Text'),
        icon: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
    },
    {
        title: t('homeActivity6'),
        text: t('homeActivity6Text'),
        icon: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
    },
];
---

<!-- Mission -->
<section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            <div>
                <h2 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">{t('aboutUsMissionHeading')}</h2>
                <p class="mt-6 text-lg leading-relaxed text-gray-600">{t('aboutUsMissionText')}</p>
            </div>
            <div class="grid grid-cols-3 gap-6 content-start">
                {stats.map((stat) => (
                    <div class="rounded-2xl bg-brand/5 p-6 text-center">
                        <div class="text-3xl font-bold text-brand sm:text-4xl">{stat.value}</div>
                        <div class="mt-2 text-sm leading-snug text-gray-600">{stat.label}</div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<!-- Activities -->
<section class="bg-gray-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="mb-10 text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">{t('aboutUsActivitiesHeading')}</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {activities.map((activity) => (
                <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-100">
                    <div class="mb-4 flex size-10 items-center justify-center rounded-xl bg-brand/10">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="size-5 text-brand"
                            aria-hidden="true"
                            set:html={activity.icon}
                        />
                    </div>
                    <h3 class="mb-2 font-semibold text-gray-900">{activity.title}</h3>
                    <p class="text-sm leading-relaxed text-gray-600">{activity.text}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Approach -->
<section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mx-auto max-w-3xl">
            <h2 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">{t('aboutUsApproachHeading')}</h2>
            <p class="mt-6 text-lg leading-relaxed text-gray-600">{t('aboutUsApproachText')}</p>

            <div class="mt-10 grid gap-6 sm:grid-cols-2">
                <div class="rounded-2xl border border-brand/20 bg-brand/5 p-6">
                    <h3 class="mb-3 text-lg font-bold text-brand">{t('aboutUsEnabling')}</h3>
                    <p class="leading-relaxed text-gray-600">{t('aboutUsEnablingText')}</p>
                </div>
                <div class="rounded-2xl border border-brand/20 bg-brand/5 p-6">
                    <h3 class="mb-3 text-lg font-bold text-brand">{t('aboutUsEmpowerment')}</h3>
                    <p class="leading-relaxed text-gray-600">{t('aboutUsEmpowermentText')}</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Association info -->
<section class="border-t border-gray-100 bg-gray-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mx-auto max-w-3xl">
            <h2 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">{t('aboutUsAssociationHeading')}</h2>
            <p class="mt-6 leading-relaxed text-gray-600">{t('aboutUsAssociationText')}</p>
        </div>
    </div>
</section>
