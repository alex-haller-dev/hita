---
import { Image } from "astro:assets";
import { translate } from "../translations/translations";
import heroImage from "../assets/images/hero-pc-lab-handover.jpg";

const locale = Astro.currentLocale ?? "de";
const t = (key: Parameters<typeof translate>[0]) => translate(key, locale);

const stats = [
    { value: "40+", label: t("heroStatLabs") },
    { value: "500+", label: t("heroStatComputers") },
    { value: new Intl.NumberFormat(locale, { style: "percent" }).format(1), label: t("heroStatVolunteers") },
];

const buttonClass =
    "inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:text-base";
---

<section class="relative overflow-hidden bg-linear-to-b from-gray-50 to-white">
    <!-- Signal arcs echoing the logo -->
    <svg
        aria-hidden="true"
        viewBox="0 0 400 400"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        class="pointer-events-none absolute -top-24 -right-24 size-112 text-brand/5 sm:size-136 sm:text-brand/10"
    >
        <path d="M60 340A280 280 0 0 1 340 60" stroke-width="28" />
        <path d="M130 340A210 210 0 0 1 340 130" stroke-width="28" />
        <path d="M200 340A140 140 0 0 1 340 200" stroke-width="28" />
    </svg>

    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[1.15fr_1fr] lg:gap-16 lg:py-24">
        <div>
            <p class="inline-flex items-center gap-2 rounded-full bg-brand/10 px-3 py-1 text-xs font-semibold tracking-wide text-brand uppercase">
                <span class="size-1.5 rounded-full bg-brand" aria-hidden="true"></span>
                {t("heroEyebrow")}
            </p>

            <h1 class="mt-5 text-3xl leading-tight font-bold tracking-tight text-balance text-gray-900 sm:text-5xl lg:text-[2.75rem] xl:text-[3.25rem]">
                {t("heroTitle")}{" "}
                <span class="text-brand">{t("heroTitleHighlight")}</span>
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-relaxed text-gray-600">
                {t("heroText")}
            </p>

            <div class="mt-8 flex flex-wrap gap-3">
                <a href="#" class={`${buttonClass} bg-brand text-white shadow-sm hover:bg-brand-dark`}>
                    {t("heroDonate")}
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-4">
                        <path d="M12 21s-7.5-4.6-9.6-9.3C.9 8.3 3 4.5 6.7 4.5c2.1 0 3.6 1.2 4.3 2.4h2c.7-1.2 2.2-2.4 4.3-2.4 3.7 0 5.8 3.8 4.3 7.2C19.5 16.4 12 21 12 21z" />
                    </svg>
                </a>
                <a href="#" class={`${buttonClass} border border-gray-300 bg-white text-gray-800 hover:border-brand hover:text-brand`}>
                    {t("heroProjects")}
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
                        <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                </a>
            </div>

            <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-gray-200 pt-8 sm:gap-8">
                {stats.map((stat) => (
                    <div class="flex flex-col gap-1">
                        <dt class="text-xs leading-snug text-gray-500 sm:text-sm">{stat.label}</dt>
                        <dd class="order-first text-2xl font-bold text-gray-900 sm:text-3xl">{stat.value}</dd>
                    </div>
                ))}
            </dl>
        </div>

        <div class="relative">
            <div class="absolute inset-0 translate-x-3 translate-y-3 rounded-3xl bg-brand/15 sm:translate-x-5 sm:translate-y-5" aria-hidden="true"></div>
            <Image
                src={heroImage}
                alt={t("heroImageAlt")}
                widths={[480, 800, 1200, 1600]}
                sizes="(min-width: 1152px) 544px, (min-width: 1024px) 45vw, 100vw"
                loading="eager"
                fetchpriority="high"
                class="relative aspect-4/3 w-full rounded-3xl object-cover shadow-xl"
            />

            <div class="relative mx-4 -mt-8 flex items-center gap-3 rounded-2xl bg-white/95 p-4 shadow-lg backdrop-blur sm:absolute sm:bottom-4 sm:-left-6 sm:mx-0 sm:mt-0 sm:max-w-xs">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand text-white" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
                        <rect x="4" y="4" width="16" height="11" rx="2" />
                        <path d="M2 19h20" />
                    </svg>
                </span>
                <p class="text-sm leading-snug">
                    <span class="block font-semibold text-gray-900">{t("heroImageCaptionTitle")}</span>
                    <span class="text-gray-600">{t("heroImageCaptionText")}</span>
                </p>
            </div>
        </div>
    </div>
</section>
