---
import LayoutDefault from '../layouts/layout.default.astro'
import Hero from '../components/hero.astro'
import Activities from '../components/activities.astro'
import HomeSupportCta from '../components/home-support-cta.astro'
import FaqSection from '../components/faq-section.astro'
import { FAQ } from '../constants/FAQ.ts'
---

<LayoutDefault>
    <Hero slot="hero" />
    <Activities />
    <!-- TODO: we should add a section where we highlight our most prominent partners with their logos -->
    <FaqSection FAQItems={FAQ.de} heading="FAQ" />
    <HomeSupportCta />
</LayoutDefault>
