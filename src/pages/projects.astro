---
import LayoutDefault from '../layouts/layout.default.astro'
import PageHeader from '../components/page-header.astro'
import { translate } from '../translations/translations'
import { resolvePath } from '../utils/path'
import Icon from '../components/icon.astro'
---

<LayoutDefault>
    <PageHeader slot="hero" title={translate('projects', 'de')} />

    <div class="flex flex-col items-center justify-center py-24 px-4 text-center">
        <div class="mb-6 flex size-16 items-center justify-center rounded-full bg-gray-100">
            <Icon name="bookOpen" class="size-8 text-gray-400" />
        </div>
        <h2 class="text-xl font-bold text-gray-900">{translate('comingSoonTitle', 'de')}</h2>
        <p class="mt-3 max-w-sm text-gray-500">{translate('comingSoonText', 'de')}</p>
        <a
            href={resolvePath('/', 'de')}
            class="mt-8 inline-flex items-center gap-2 rounded-full border border-gray-300 bg-white px-5 py-2.5 text-sm font-semibold text-gray-800 transition-colors hover:border-brand hover:text-brand"
        >
            ← {translate('comingSoonBackHome', 'de')}
        </a>
    </div>
</LayoutDefault>
